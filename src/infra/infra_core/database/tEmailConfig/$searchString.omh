If tlDatabases.DAM='WebService'
	# pass parameters to web service
	# $callService (pFieldReference, row(TableClassName, CurrentMethodName, p1,...,pn) ) ## result will be returned in pFieldReference, row() contains the parameters for the call
	Calculate ldtStart as #D
	Do toWeb.$callFetch($cinst,irErrorSQL,row($cinst.$class().$name,$cmethod().$name,row(pcReturnWhat,pcString),$cinst.$type,0,ilRESTextensions))
	Calculate inServiceMS as ddiff(kCentiSecond,ldtStart,#D)*10
	Calculate inRESTserverMS as toWeb.inServerTime
	If toWeb.irResponse.httpStatusCode=200
		# the result should be in this object ## however there may be a SQL error
		If irErrorSQL.NativeErrorText<>''
			Quit method kFalse
		End If
		Quit method kTrue
	Else
		Quit method kFalse
	End If
End If

If pos('%',pcString)
	# wildcard included
Else
	Calculate pcString as con('%',pcString,'%')
End If

Do $cinst.$ImmediateSession(loSession,loStatement) Returns lbImmediateSession
If lbImmediateSession
	Do $cinst.$SetSession(loSession,loStatement)
Else If not(ibGoodConnectionToDb)
	Quit method kFalse
End If

Begin statement
If low(pcReturnWhat)='count'
	Sta:select count(*) from (
End If
Sta:select distinct [$cinst.$selectnames()]
Sta:from [$cinst.$servertablenames]
Sta: join [lrEmailText.$servertablenames] on ELT_ELC_REF = ELC_SEQ

Sta:where   ELC_GO_REF = @[trGroupOrg.GO_SEQ]
Sta:and  ( ELC_CODE ilike @[pcString]
Sta: or    ELC_NAME ilike @[pcString]
Sta: or    ELC_DESC ilike @[pcString]

Sta: or    cast(ELC_HEADERS as text) ilike @[pcString]
Sta: or    ELC_SERVER ilike @[pcString]

# to, cc, bcc are JSON columns and need re-casting
Sta: or    cast(ELC_TO as text) ilike @[pcString]
Sta: or    cast(ELC_CC as text) ilike @[pcString]
Sta: or    cast(ELC_BCC as text) ilike @[pcString]

Sta: or    ELC_SENDER_NAME ilike @[pcString]
Sta: or    ELC_SENDER_ADDR ilike @[pcString]
Sta: or    ELC_COMMENT ilike @[pcString]

Sta: or    ELT_LANG ilike @[pcString]
Sta: or    ELT_SUBJECT ilike @[pcString]
Sta: or    ELT_MSG_TEXT ilike @[pcString]
Sta: or    ELT_MSG_HTML ilike @[pcString]

Sta:)
If low(pcReturnWhat)='count'
	Sta:) x
End If
End statement

If low(pcReturnWhat)='count'
	Do $cinst.$executesqlandfetchinto(lnCount) Returns lbOK
Else If low(pcReturnWhat)='result'
	Do $cinst.$executesqlandfetch() Returns lbOK
End If

If lbImmediateSession
	Do $cinst.$SetSession(#NULL,#NULL,kTrue)
End If

If low(pcReturnWhat)='result'
	While $Loop($cinst)
		Do $cinst.$displayName()
	End While
End If

If low(pcReturnWhat)='count'
	Quit method lnCount
Else If low(pcReturnWhat)='result'
	Quit method lbOK
End If

Quit method lbOK
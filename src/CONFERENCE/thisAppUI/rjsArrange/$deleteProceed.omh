# store local copy of row to be deleted
Calculate lrDeleted as irCurrentRecord

Do inherited

# irCurrentRecord has been cleared now, after $delete, and removed from ilDisplayList
# Do we have a row from one of the lists to remove?

# DAY 1
Do ilDay1AM.$search($ref.ARR_SEQ=lrDeleted.ARR_SEQ,1,0,0,0) Returns lbFound
If lbFound
	Do ilDay1AM.$remove(ilDay1AM.$line)
End If

Do ilDay1PM.$search($ref.ARR_SEQ=lrDeleted.ARR_SEQ,1,0,0,0) Returns lbFound
If lbFound
	Do ilDay1PM.$remove(ilDay1PM.$line)
End If

Do ilDay1EVE.$search($ref.ARR_SEQ=lrDeleted.ARR_SEQ,1,0,0,0) Returns lbFound
If lbFound
	Do ilDay1EVE.$remove(ilDay1EVE.$line)
End If


End If

# DAY 5
Do ilDay5AM.$search($ref.ARR_SEQ=lrDeleted.ARR_SEQ,1,0,0,0) Returns lbFound
If lbFound
	Do ilDay5AM.$remove(ilDay5AM.$line)
End If

Do ilDay5PM.$search($ref.ARR_SEQ=lrDeleted.ARR_SEQ,1,0,0,0) Returns lbFound
If lbFound
	Do ilDay5PM.$remove(ilDay5PM.$line)
End If

Do ilDay5EVE.$search($ref.ARR_SEQ=lrDeleted.ARR_SEQ,1,0,0,0) Returns lbFound
If lbFound
	Do ilDay5EVE.$remove(ilDay5EVE.$line)
End If
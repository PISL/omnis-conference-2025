End If

Do ilDay4PM.$search($ref.ARR_SEQ=lrDeleted.ARR_SEQ,1,0,0,0) Returns lbFound
If lbFound
	Do ilDay4PM.$remove(ilDay4PM.$line)
End If

Do ilDay4EVE.$search($ref.ARR_SEQ=lrDeleted.ARR_SEQ,1,0,0,0) Returns lbFound
If lbFound

If icMode<>''
	Calculate lnlinestyle as 2
	Calculate lrFieldAttributes as OJSON.$jsontolistorrow(trFormColours.FIELDCOLOURS)
	Calculate lnbordercolour as eval(lrFieldAttributes.mandatory)
	Calculate lneffect as kJSborderPlain
	Calculate lnEnterable as eval(lrFieldAttributes.enterable)
	Calculate lnUnique as eval(lrFieldAttributes.unique)
End If

If inCurrentTab=cnTabDGPerson
	# set attributes for Unique and Mandatory fields
	
	Calculate $cinst.$objs.DG_REG_DATE.$linestyle as lnlinestyle
	Calculate $cinst.$objs.DG_REG_DATE.$bordercolor as lnbordercolour
	Calculate $cinst.$objs.DG_REG_DATE.$effect as lneffect
	Calculate $cinst.$objs.DG_REG_DATE.$backcolor as lnEnterable
	
	# now set Enterable on the remainder
	Calculate $cinst.$objs.DG_GROUP.$backcolor as lnEnterable
	
	Calculate $cinst.$objs.DG_COMMENT.$backcolor as lnEnterable
	
Else If inCurrentTab=cnTabTopicsConf
	# error lines removed
	
Else If inCurrentTab=cnTabTopicEditor
	Calculate $cinst.$objs.TPC_TITLE.$linestyle as lnlinestyle
	Calculate $cinst.$objs.TPC_TITLE.$bordercolor as lnbordercolour
	Calculate $cinst.$objs.TPC_TITLE.$effect as lneffect
	Calculate $cinst.$objs.TPC_TITLE.$backcolor as lnEnterable
	
	Calculate $cinst.$objs.TPC_ABSTRACT.$linestyle as lnlinestyle
	# Calculate $cinst.$objs.TPC_ABSTRACT.$bordercolor as lnbordercolour
	Calculate $cinst.$objs.TPC_ABSTRACT.$effect as lneffect
	Calculate $cinst.$objs.TPC_ABSTRACT.$backcolor as lnEnterable
	
	Calculate $cinst.$objs.TPC_DESC.$linestyle as lnlinestyle
	# Calculate $cinst.$objs.TPC_DESC.$bordercolor as lnbordercolour
	Calculate $cinst.$objs.TPC_DESC.$effect as lneffect
	Calculate $cinst.$objs.TPC_DESC.$backcolor as lnEnterable
	
	Calculate $cinst.$objs.TPC_DURN_MINS.$backcolor as lnEnterable
	Calculate $cinst.$objs.TPC_BACKCOLOR.$backcolor as lnEnterable ## droplist
	Calculate $cinst.$objs.TPC_TEXTCOLOR.$backcolor as lnEnterable ## droplist
	
End If